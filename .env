# =============================================================================
# Hadoop Cluster Configuration — Environment Variables
# =============================================================================
# These env vars are automatically converted by the apache/hadoop:3.5.0 image
# into XML configuration files at container startup.
#
# Convention:  FILE.xml_property.name=value
# Example:     CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
#              → core-site.xml gets <property><name>fs.defaultFS</name><value>...</value></property>
# =============================================================================

HADOOP_HOME=/opt/hadoop

# --- core-site.xml ----------------------------------------------------------
# Default filesystem URI (NameNode RPC address)
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
# Proxy user rules allow the HttpFS gateway to impersonate users
CORE-SITE.XML_hadoop.proxyuser.root.hosts=*
CORE-SITE.XML_hadoop.proxyuser.root.groups=*

# --- hdfs-site.xml ----------------------------------------------------------
# NameNode RPC address used by DataNodes and clients to connect
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
# Number of replicas for each block (3 = one lost node still has 2 copies)
HDFS-SITE.XML_dfs.replication=3
# Use hostnames instead of IPs in block location reports (required for Docker networking)
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true

# --- mapred-site.xml --------------------------------------------------------
# Use YARN as the MapReduce resource manager (instead of the classic standalone mode)
MAPRED-SITE.XML_mapreduce.framework.name=yarn
# Environment variables for MapReduce Application Master, map, and reduce tasks
MAPRED-SITE.XML_yarn.app.mapreduce.am.env=HADOOP_MAPRED_HOME=$HADOOP_HOME
MAPRED-SITE.XML_mapreduce.map.env=HADOOP_MAPRED_HOME=$HADOOP_HOME
MAPRED-SITE.XML_mapreduce.reduce.env=HADOOP_MAPRED_HOME=$HADOOP_HOME

# --- yarn-site.xml ----------------------------------------------------------
# Hostname where the YARN ResourceManager runs (resolved via Docker networking)
YARN-SITE.XML_yarn.resourcemanager.hostname=resourcemanager
# Disable physical/virtual memory checks (containers have cgroup limits instead)
YARN-SITE.XML_yarn.nodemanager.pmem-check-enabled=false
YARN-SITE.XML_yarn.nodemanager.vmem-check-enabled=false
# Delay (seconds) before YARN deletes completed container work dirs — useful for debugging
YARN-SITE.XML_yarn.nodemanager.delete.debug-delay-sec=600
# Auxiliary service for the MapReduce Shuffle (data transfer between mappers and reducers)
YARN-SITE.XML_yarn.nodemanager.aux-services=mapreduce_shuffle

# --- capacity-scheduler.xml -------------------------------------------------
# Maximum concurrent applications in the cluster
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.maximum-applications=10000
# Maximum percentage of resources allocated to Application Masters (prevents AM starvation)
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.maximum-am-resource-percent=0.1
# Resource calculator (DefaultResourceCalculator = memory only; DominantResourceCalculator = memory + CPU)
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.resource-calculator=org.apache.hadoop.yarn.util.resource.DefaultResourceCalculator
# Single queue named "default" with 100% capacity
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.queues=default
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.capacity=100
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.maximum-capacity=100
# Maximum number of concurrent applications a single user can submit (1 = no skew)
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.user-limit-factor=1
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.state=RUNNING
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.acl_submit_applications=*
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.root.default.acl_administer_queue=*
# Locality delay (how long the scheduler waits before relaxing rack/off-rack constraints)
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.node-locality-delay=40
# Queue mapping (empty = no mapping rules defined)
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.queue-mappings=
CAPACITY-SCHEDULER.XML_yarn.scheduler.capacity.queue-mappings-override.enable=false
